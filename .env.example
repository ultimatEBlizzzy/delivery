# =====================================================================================
# Hardware Delivery – environment configuration
#
#   cp .env.example .env      # then review every value marked CHANGE-ME
#
# Real secrets must NEVER be committed. `.env` is git-ignored. The placeholder secrets
# below are only fine for local development: the API refuses to start in production
# (NODE_ENV=production) if they still look like placeholders.
# =====================================================================================

# ---- Runtime ------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public origin of the API (used to build absolute links) and of the web app.
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Comma-separated list of browser origins allowed to call the API (CORS). No wildcard in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Set to the number of reverse proxies in front of the API (e.g. 1 behind nginx/Caddy/ELB) so that
# rate limiting and audit logs see the real client IP. Leave false when not behind a proxy.
TRUST_PROXY=false

# ---- PostgreSQL + PostGIS -----------------------------------------------------------
# Docker Compose db service (docker compose up -d db):
DATABASE_URL=postgresql://hd_user:hd_password@localhost:5432/hardware_delivery
# Integration tests (npm run test:e2e). By default they start their own throw-away embedded
# PostGIS database, so nothing is needed. To run them against a real server instead, set this to a
# dedicated database whose name contains "test" – its schema is WIPED before every run.
# (The Docker Compose db service creates `hardware_delivery_test` for you.)
# TEST_DATABASE_URL=postgresql://hd_user:hd_password@localhost:5432/hardware_delivery_test
# Docker-free alternative (npm run db:embedded) prints its own URL, e.g.:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres
# Connections per API instance.
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_LOGGING=false
# Apply pending migrations automatically when the API starts (handy for small deployments).
RUN_MIGRATIONS_ON_START=false

# Values consumed by docker-compose.yml to create the database container.
POSTGRES_USER=hd_user
POSTGRES_PASSWORD=hd_password
POSTGRES_DB=hardware_delivery
POSTGRES_PORT=5432

# ---- Authentication -----------------------------------------------------------------
# CHANGE-ME: at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=CHANGE-ME-dev-only-access-secret-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=hd_refresh
# Cookies are Secure (HTTPS only) by default in production. Set true/false to override.
COOKIE_SECURE=false
# strict | lax | none  (none requires COOKIE_SECURE=true and is only needed for cross-site hosting)
COOKIE_SAMESITE=strict
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# Log verbosity: error | warn | log | debug | verbose
LOG_LEVEL=log

# ---- Rate limiting & API docs -------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
# Stricter per-IP limit for login/registration
RATE_LIMIT_AUTH_MAX=20
# Swagger UI at /api/docs (defaults to on in development, off in production)
SWAGGER_ENABLED=true

# ---- Pluggable providers ------------------------------------------------------------
# Every external dependency sits behind an interface with a working mock implementation.
PAYMENT_PROVIDER=mock
MAPS_PROVIDER=mock
STORAGE_PROVIDER=local
# in_app is always real; email/sms/push are mock channels that log what they would send.
NOTIFICATION_CHANNELS=in_app,email,sms,push
# Mock providers are refused in production unless you explicitly allow them (staging/demo only).
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false
MOCK_PAYMENT_WEBHOOK_SECRET=CHANGE-ME-mock-webhook-secret

# ---- File storage -------------------------------------------------------------------
UPLOAD_DIR=./uploads
# CHANGE-ME: at least 32 random characters. Signs short-lived URLs for private files.
STORAGE_SIGNING_SECRET=CHANGE-ME-dev-only-storage-secret-0123456789abcdef
STORAGE_SIGNED_URL_TTL_SECONDS=600

# ---- Background jobs ----------------------------------------------------------------
# Payment timeouts, driver-offer expiry and dispatch retries. Run on exactly one API instance
# (or keep true and run a single replica).
SCHEDULER_ENABLED=true

# ---- Frontend (build-time, PUBLIC values only – never put secrets here) --------------
# The SPA calls the API through a same-origin proxy (Vite dev server / nginx), so no host is needed.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=BuildRun
# Leaflet tile server. OpenStreetMap's public tiles are for light/demo use only – see
# https://operations.osmfoundation.org/policies/tiles/ and use a commercial provider in production.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# Lets drivers simulate GPS movement along the route (demo/QA). Disable in production.
VITE_ENABLE_LOCATION_SIMULATOR=true
# Shows one-click demo logins on the sign-in pages (only useful after `npm run db:seed`). Turn off in production.
VITE_SHOW_DEMO_ACCOUNTS=true
# Where the Vite dev server proxies /api and /uploads to
VITE_DEV_API_TARGET=http://localhost:3000

# ---- Future providers (leave blank until you integrate them) --------------------------
# PayFast / Yoco payments
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
# Google Maps Platform (geocoding, directions, distance matrix) – server-side key, restrict by IP
GOOGLE_MAPS_API_KEY=
# Email (SMTP) / SMS gateway / push (FCM)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_API_KEY=
FCM_SERVER_KEY=
# S3-compatible object storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
